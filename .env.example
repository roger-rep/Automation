# Mock demo needs none of these settings. Never commit your actual .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Jira Cloud tenant URL, account email, and an unscoped API token.
JIRA_URL=https://your-team.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DEMO
JIRA_ISSUE_TYPE=Bug
# Optional JSON object of extra Jira field IDs -> values, e.g. {"customfield_10001":"Support"}
JIRA_EXTRA_FIELDS={}

# Local submission state contains hashes/status/issue keys, not feedback or tokens.
SUBMISSION_DB=.local/submissions.sqlite3
